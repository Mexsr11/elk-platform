# ============ 全局配置，三台必须完全一致 ============
STACK_VERSION=8.19.0
CLUSTER_NAME=elk-prod
ES_PORT=9200
ES_TRANSPORT_PORT=9300

# ============ 每台机器不同：唯一的差异化入口 ============
# 节点名，与主机名保持一致
NODE_NAME=es01
# 本机内网 IP。host 网络模式下 ES 直接绑这个地址，必须写对
NODE_IP=192.168.132.11
# 节点角色。3 节点小集群全部承担 master+data+ingest
# 注意：逗号分隔，不能有空格
NODE_ROLES=master,data,ingest

# ============ 集群发现：每台只填另外两台的 IP ============
# es01 -> 192.168.132.12:9300,192.168.132.13:9300
# es02 -> 192.168.132.11:9300,192.168.132.13:9300
# es03 -> 192.168.132.11:9300,192.168.132.12:9300
SEED_HOSTS=192.168.132.12:9300,192.168.132.13:9300

# ============ 仅首次引导有效（首次组建集群时才需要）============
# 【首次组建】填三个 master 候选节点名，并在 docker-compose.yml 里取消该行注释
# 【组建完成后】必须从 docker-compose.yml 里「注释掉整行」——不能设成空值！
#   设空值会导致 ES 拒绝启动：
#   ElasticsearchParseException: null-valued setting found for key [cluster.initial_master_nodes]
# 原因：保留旧名单时若多节点同时重启，可能按旧名单重新引导，造成脑裂
# 仅当集群数据全部丢失、需要重新组建时，才恢复这个流程
INITIAL_MASTER_NODES=es01,es02,es03

# ============ JVM 堆：物理内存的一半，且不超过 31GB ============
ES_HEAP=1g

# ============ 密码：Lab 6 启用安全后才使用 ============
# ELASTIC_PASSWORD=   ← Lab 6 步骤 5 追加，模板里禁止放假密码

# ============ Lab 9：Kibana ============
# 服务账号密码（Kibana 进程连 ES 用，不是给人登录的）
# KIBANA_SYSTEM_PASSWORD=
# 保存对象加密密钥：openssl rand -hex 32 生成，32 字节 = 64 位 hex
# KIBANA_ENCRYPTION_KEY=
